// 4 SMALLEST NUMBER WHEN 3 INPUTS TAKEN
import java.util.*;
class Main{
	public static void main(String[] args) {
		Scanner obj = new Scanner(System.in);
		int a = obj.nextInt();
		int b = obj.nextInt();
		int c = obj.nextInt();
		if(a<b && a<c)
		System.out.println( a + " is smaller " );
		else if(b<a && b<c)
		System.out.println( b + " is smaller " );
		else
		System.out.println( c + " is smaller ");
	}
}

