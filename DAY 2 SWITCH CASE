/ 7*write a java program to check greatest of three numbers*/
import java.util.Scanner;
class Main {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter a number  :");
		int a=sc.nextInt();
		int b=sc.nextInt();
		int c=sc.nextInt();
		if(a>b && a>c) {
			System.out.println(a+"is a ,that is  greater.");
		} else if(b>a && b>c) {
			System.out.println(b+"is  b ,that is  greater.");
		}else{
		    System.out.println(c+" is c ,that is greater.");
		}
		sc.close();
	}
}

