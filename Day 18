                    s.push(val);
                    break;

                case 2:
                    int removed = s.pop();

                    if (removed != -1) {
                        System.out.println("Deleted: " + removed);
                    }
                    break;

                case 3:
                    s.peek();
                    break;

                case 4:
                    s.display();
                    break;

                case 5:
                    System.out.println("Exiting...");
                    return;

                default:
                    System.out.println("Invalid choice");
            }
        }
    }
}
