//count odd digits and even digits
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
	    int ec=0,od=0;
	    int d;
		while(n!=0){
		    d=n%10;
		    if(d%2==0){
		        ec++;
		    }else{
		        od++;
		    }
		    n=n/10;
		    }
		    System.out.println("ec: "+ec+"\nod: "+od);
	}
}
