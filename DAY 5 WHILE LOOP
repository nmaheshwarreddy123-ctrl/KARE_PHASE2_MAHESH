//4to found even digits and odd digits in the gtiven number 
import java.util.*;
class Main{
    public static void main(String[]args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int d,ec=0,oc=0;
        while (n!=0)
        {
            d = n%10;
            if(d%2==0)
            ec++;
            else
            oc++;
            n=n/10;
        }
        System.out.println("odd digit count: "+oc);
        System.out.println("Even digit count: "+ec);
        
    }
}
//5to count prime digits in the given number
import java.util.*;
class Main{
    public static void main(String[]args){
        Scanner obj = new Scanner(System.in);
        int n = obj.nextInt();
        int c =0,d;
        while (n!=0)
        {
            d = n%10;
            if(d==2||d==3||d==5||d==7)
            c++;
            n=n/10;
        }
        System.out.println("prime digit count: "+c);
        
    }
}
//6 to check whether the number is palindrome or not palindrome
import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner obj = new Scanner(System.in);

        int n = obj.nextInt();
        int original = n;
        int reverse = 0;

        while (n != 0) {
            int digit = n % 10;
            reverse = reverse * 10 + digit;
            n = n / 10;
        }

        if (original == reverse) {
            System.out.println("Palindrome");
        } else {
            System.out.println("Not Palindrome");
        }
    }
}
