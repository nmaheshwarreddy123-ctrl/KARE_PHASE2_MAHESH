//CIRCULAR SINGLY LINKED LIST
import java.util.*;

class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}

class Main {
    Node first = null;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Main m = new Main();

        int d = sc.nextInt();

        while (d != -1) {
            m.insert(d);
            d = sc.nextInt();
        }

        System.out.println("Sum = " + m.sum());
    }

    void insert(int d) {
        Node n = new Node(d);

        if (first == null) {
            first = n;
            n.next = first;
        } else {
            Node temp = first;

            while (temp.next != first) {
                temp = temp.next;
            }

            temp.next = n;
            n.next = first;
        }
    }

    int sum() {
        if (first == null) {
            return 0;
        }

        int sum = 0;
        Node temp = first;

        do {
            sum = sum + temp.data;
            temp = temp.next;
        } while (temp != first);

        return sum;
    }
}
