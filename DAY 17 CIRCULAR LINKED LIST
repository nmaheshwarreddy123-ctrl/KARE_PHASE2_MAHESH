import java.util.*;

class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}

class Main {
    Node first = null;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        Main m = new Main();

        int d = sc.nextInt();

        while (d != -1) {
            m.insert(d);
            d = sc.nextInt();
        }

        m.reverse();
        m.display();
    }

    void insert(int d) {
        Node n = new Node(d);

        if (first == null) {
            first = n;
            n.next = first;
        } else {
            Node temp = first;

            while (temp.next != first) {
                temp = temp.next;
            }

            temp.next = n;
            n.next = first;
        }
    }
    void reverse() {
        if (first == null || first.next == first) {
            return;
        }

        Node prev = null;
        Node current = first;
        Node next;

        do {
            next = current.next;
            current.next = prev;
            prev = current;
            current = next;
        } while (current != first);

        first.next = prev;
        first = prev;
    }
    void display() {
        if (first == null) {
            System.out.println("List is Empty");
            return;
        }

        Node temp = first;

        do {
            System.out.print(temp.data + " ");
